# VPS (production) par ye sab set karein. Local `npm run dev` me Shopify CLI SHOPIFY_* khud deta hai.
NODE_ENV=production
PORT=3000
SHOPIFY_APP_URL=https://speed-optimization.neximet.com
SHOPIFY_API_KEY=050b2d05a65e41a0a23173382f19b857
# Partner/Dev Dashboard -> App -> Settings -> Client secret. Kabhi git me commit na karein.
SHOPIFY_API_SECRET=
SCOPES=read_themes,write_themes

# Google PageSpeed Insights API key (https://developers.google.com/speed/docs/insights/v5/get-started)
# Key ke baghair bhi chalta hai lekin rate limit bohot kam hoti hai.
PAGESPEED_API_KEY=
