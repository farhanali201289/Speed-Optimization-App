# Set all of these on the VPS (production). For local `npm run dev`, the Shopify CLI provides SHOPIFY_* itself.
NODE_ENV=production
PORT=3000
SHOPIFY_APP_URL=https://speed-optimization.neximet.com
SHOPIFY_API_KEY=59e1202369daecd4520b1bc77423178c
# Partner/Dev Dashboard -> App -> Settings -> Client secret. Never commit it to git.
SHOPIFY_API_SECRET=
SCOPES=read_themes,write_themes

# Google PageSpeed Insights API key (https://developers.google.com/speed/docs/insights/v5/get-started)
# Works without a key, but the rate limit is very low.
PAGESPEED_API_KEY=
